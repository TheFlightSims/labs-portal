# Database Configuration
JHUB_DB_USERNAME=
JHUB_DB_PASSWORD=
JHUB_DB_HOST=
JHUB_DB_DATABASE=
JHUB_DB_PORT=
JHUB_DB_DIALECT=
JHUB_DB_DRIVER=
JHUB_DB_TYPE=

# SSL Certificates
JHUB_PUB_KEY=/etc/labs_portal/ssl/labs_portal.key
JHUB_PRI_CERT=/etc/labs_portal/ssl/labs_portal.crt

# JupyterHub Proxy Secrets
JHUB_PROXY_AUTH_TOKEN=/etc/labs_portal/proxy_auth_token
JHUB_COOKIE_SECRET=/etc/labs_portal/cookie_secret

# Default Shell for users
JHUB_DEFAULT_SHELL=/bin/bash

# Allowed regular users and admin users/groups
JHUB_ALLOWED_USERS=
JHUB_ADMIN_USERS=
JHUB_ADMIN_GROUP=

# Set for each user limits
JHUB_CPU_LIMIT=1
JHUB_MEM_LIMIT=1024M

# JupyterHub Debug
JHUB_DEBUG=true